# WindScope Environment Configuration Example
# Copy to .env in backend/ or root as needed

# Application Branding
APP_NAME=WindScope — UK Wind Forecast Intelligence
APP_VERSION=1.0.0
DEBUG=False

# Elexon BMRS Insights Solution API Base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Default Evaluation Parameters (Strictly January 2026)
DEFAULT_START_DATE=2026-01-01
DEFAULT_END_DATE=2026-01-31

# Default Purchasing Decision Cutoff Assumption
# Standard UK Balancing Mechanism Gate Closure is 1 hour before delivery
DEFAULT_CUTOFF_PRESET=gate_closure
DEFAULT_CUTOFF_HOURS=1.0

# In-Memory Cache TTL in seconds (10 minutes)
CACHE_TTL_SECONDS=600

# CORS Allowed Origins (Comma-separated or list)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:3000"]
